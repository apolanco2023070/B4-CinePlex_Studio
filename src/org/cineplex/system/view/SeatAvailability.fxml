<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="460.0" prefWidth="600.0" spacing="10.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.cineplex.system.controller.SeatAvailabilityController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <children>
      <Label text="Disponibilidad de Asientos" underline="true">
         <font>
            <Font size="21.0" />
         </font>
      </Label>
      <Separator prefWidth="200.0" />

      <Label fx:id="lblFuncion" text="Selecciona una función:" />
      <HBox spacing="10.0" alignment="CENTER_LEFT">
         <children>
            <ComboBox fx:id="cmbFunciones" prefWidth="380.0" promptText="Funciones disponibles" />
            <Button fx:id="btnConsultar" mnemonicParsing="false" onAction="#consultarDisponibilidad" text="Consultar disponibilidad" />
         </children>
      </HBox>

      <Separator prefWidth="200.0" />
      <Label text="Asientos de la función seleccionada">
         <font>
            <Font size="16.0" />
         </font>
      </Label>

      <TableView fx:id="tblAsientos" prefHeight="225.0" prefWidth="580.0">
        <columns>
          <TableColumn fx:id="colNumero" prefWidth="150.0" text="Número" />
            <TableColumn fx:id="colEstado" prefWidth="150.0" text="Estado" />
        </columns>
      </TableView>

      <HBox spacing="10.0" alignment="CENTER_LEFT">
         <children>
            <Button fx:id="btnReservar" mnemonicParsing="false" onAction="#reservarAsiento" text="Reservar asiento seleccionado" style="-fx-background-color: #27ae60; -fx-text-fill: white;" />
            <Button fx:id="btnRegresar" mnemonicParsing="false" onAction="#regresarMenu" text="Regresar" />
         </children>
      </HBox>
   </children>
</VBox>
