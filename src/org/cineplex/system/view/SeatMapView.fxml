<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.cineplex.system.controller.SeatMapController"
      spacing="15" 
      style="-fx-padding: 20;">

    <!-- Información de la función -->
    <VBox style="-fx-background-color: #2c2c2c; -fx-padding: 15; -fx-background-radius: 5;">
        <Label fx:id="lblMovieInfo" text="Película - Sala - Fecha/Hora" 
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
    </VBox>

    <!-- Pantalla (decorativo) -->
    <Label text="PANTALLA" 
           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-alignment: center;"
           maxWidth="Infinity"/>
    <Separator/>

    <!-- Mapa de asientos (se genera dinámicamente) -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox fx:id="seatMapContainer" spacing="10" style="-fx-padding: 10;"/>
    </ScrollPane>

    <!-- Leyenda -->
    <HBox spacing="20" alignment="CENTER">
        <Label text="🟢 Disponible" style="-fx-text-fill: green; -fx-font-weight: bold;"/>
        <Label text="🔴 Reservado" style="-fx-text-fill: red; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Botón cerrar -->
    <HBox alignment="CENTER_RIGHT">
        <Button fx:id="btnClose" text="Cerrar" onAction="#closeWindow" 
                style="-fx-background-color: #6c757d; -fx-text-fill: white;"/>
    </HBox>

</VBox>