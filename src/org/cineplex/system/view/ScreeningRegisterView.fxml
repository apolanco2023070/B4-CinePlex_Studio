<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.cineplex.system.controller.ScreeningRegisterController"
      spacing="15" 
      style="-fx-padding: 20;">

    <Label text="Registrar Nueva Función" 
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Película:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="cmbMovies" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Sala:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="cmbAuditoriums" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Fecha:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <DatePicker fx:id="dpDate" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Hora (HH:mm):" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="txtTime" prefWidth="250" promptText="14:30" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnSave" text="Guardar" onAction="#saveScreening" 
                style="-fx-background-color: #28a745; -fx-text-fill: white;"/>
        <Button fx:id="btnCancel" text="Cancelar" onAction="#cancel"
                style="-fx-background-color: #dc3545; -fx-text-fill: white;"/>
    </HBox>

</VBox>