<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root" stylesheets="@/org/cineplex/system/resources/styles/cineplex.css" 
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="org.cineplex.system.controller.ScreeningConsultationController">

    <top>
        <HBox alignment="CENTER" spacing="10">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <Label styleClass="title-label" text="🎬 Consultar y Editar Funciones Programadas" />
        </HBox>
    </top>

    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-bar">
                <Label styleClass="field-label" text="🎥 Película:" />
                <ComboBox fx:id="comboBoxMovies" prefWidth="250.0" promptText="Todas las películas" HBox.hgrow="ALWAYS" />
                
                <Label styleClass="field-label" text="🎪 Sala:">
                    <HBox.margin>
                        <Insets left="10.0" />
                    </HBox.margin>
                </Label>
                <ComboBox fx:id="comboBoxAuditoriums" prefWidth="200.0" promptText="Todas las salas" />
                
                <Button fx:id="btnFilter" onAction="#loadScreenings" styleClass="btn-secondary" text="🔍 Filtrar" />
                <Button fx:id="btnClear" onAction="#clearFilters" styleClass="btn-ghost" text="🔄 Limpiar" />
            </HBox>

            <TableView fx:id="tableViewScreenings" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colMovie" prefWidth="200.0" text="Película" />
                    <TableColumn fx:id="colAuditorium" prefWidth="120.0" text="Sala" />
                    <TableColumn fx:id="colDate" prefWidth="100.0" text="Fecha" />
                    <TableColumn fx:id="colTime" prefWidth="80.0" text="Hora" />
                    <TableColumn fx:id="colDuration" prefWidth="80.0" text="Duración" />
                    <TableColumn fx:id="colActions" prefWidth="100.0" text="Acciones" />
                </columns>
            </TableView>

            <HBox alignment="CENTER" spacing="10.0">
                <Button fx:id="btnRefresh" onAction="#loadScreenings" styleClass="btn-success" text="🔄 Actualizar" />
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <Button fx:id="btnBack" onAction="#goBackToPanel" styleClass="btn-danger" text="⬅ Volver al Panel" />
        </HBox>
    </bottom>

</BorderPane>