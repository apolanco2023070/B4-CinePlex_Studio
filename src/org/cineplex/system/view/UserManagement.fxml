<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="org.cineplex.system.controller.UserManagementController" 
      style="-fx-background-color: #ecf0f1;">
    <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/></padding>
    
    <Label text="Gestionar Cuentas de Gerentes" style="-fx-text-fill: #2c3e50;">
        <font><Font size="24.0" /></font>
    </Label>
    
    <GridPane hgap="10" vgap="15" alignment="CENTER">
        <Label text="Nombre Completo:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #34495e;"/>
        <TextField fx:id="txtFullName" promptText="Ej: Juan Pérez" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250"/>
        
        <Label text="Usuario:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #34495e;"/>
        <TextField fx:id="txtUsername" promptText="Ej: juan.perez" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="250"/>
        
        <Label text="Contraseña:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-text-fill: #34495e;"/>
        <PasswordField fx:id="txtPassword" promptText="Mínimo 6 caracteres" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="250"/>
        
        <Label text="Email:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-text-fill: #34495e;"/>
        <TextField fx:id="txtEmail" promptText="Ej: juan@cineplex.com" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="250"/>
    </GridPane>
    
    <Label fx:id="lblMensaje" style="-fx-text-fill: red;" wrapText="true" maxWidth="400"/>
    
    <VBox spacing="10" alignment="CENTER">
        <Button text="Registrar Gerente" onAction="#registrarGerente" 
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px;" 
                prefWidth="200"/>
        <Button text="Volver al Panel" onAction="#volverPanel" 
                style="-fx-background-color: #95a5a6; -fx-text-fill: white;" 
                prefWidth="200"/>
    </VBox>
</VBox>
