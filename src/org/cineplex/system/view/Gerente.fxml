<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #ecf0f1;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.cineplex.system.controller.GerenteController">
    
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>
    
    <!-- Título del Panel -->
    <Label style="-fx-text-fill: #16a085; -fx-font-weight: bold;" text="Panel Gerente">
        <font>
            <Font size="28.0" />
        </font>
    </Label>
    
    <!-- Label que se actualiza con el nombre del usuario -->
    <Label fx:id="lblBienvenida" style="-fx-text-fill: #34495e;" text="Bienvenido">
        <font>
            <Font size="16.0" />
        </font>
    </Label>
    
    <!-- Botones de acción -->
    <VBox alignment="CENTER" maxWidth="300" spacing="15.0">
        
        <Button onAction="#abrirCartelera" prefWidth="300" 
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 14px;" 
                text="Gestionar Cartelera" />
        
        <Button onAction="#consultarReservas" prefWidth="300" 
                style="-fx-background-color: #16a085; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 14px;" 
                text="Consultar Reservas" />
        
        <Button onAction="#cerrarSesion" prefWidth="300" 
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 14px;" 
                text="Cerrar Sesión" />
                
    </VBox>
    
</VBox>