<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="550.0" prefWidth="650.0" spacing="15.0" styleClass="root" stylesheets="@/org/cineplex/system/resources/styles/cineplex.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="org.cineplex.system.controller.SeatsController">
   <padding>
      <Insets bottom="aadm20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <children>
      <Label styleClass="title-label" text="Gestión de Asientos y Salas" />
      <Separator prefWidth="200.0" />

      <VBox spacing="12.0" styleClass="filter-bar">
         <GridPane hgap="12.0" vgap="12.0">
            <columnConstraints>
               <ColumnConstraints hgrow="NEVER" minWidth="100.0" />
               <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
            </columnConstraints>
            <rowConstraints>
               <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
               <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
               <Label fx:id="lblRooms" styleClass="field-label" text="Sala:" />
               <ComboBox fx:id="cmbRooms" prefWidth="250.0" promptText="Salas Disponibles" GridPane.columnIndex="1" />

               <Label fx:id="lblCapacity" styleClass="field-label" text="Capacidad:" GridPane.rowIndex="1" />
               <TextField fx:id="txtCapacity" prefWidth="250.0" promptText="Ingrese capacidad" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </children>
         </GridPane>

         <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
               <Button fx:id="btnRegisterRoom" mnemonicParsing="false" onAction="#saveAuditorium" styleClass="btn-secondary" text="Registrar Sala" />
               <Button fx:id="btnRegisterSeats" mnemonicParsing="false" onAction="#generateSeats" styleClass="btn-success" text="Generar Asientos" />
            </children>
         </HBox>
      </VBox>

      <Separator prefWidth="200.0" />

      <Label styleClass="subtitle-label" text="Asientos de la sala seleccionada" />

      <TableView fx:id="tblSeats" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colNumber" prefWidth="280.0" text="Número" />
            <TableColumn fx:id="colStatus" prefWidth="280.0" text="Estado" />
         </columns>
      </TableView>

      <HBox alignment="CENTER_RIGHT">
         <Button fx:id="btnBack" mnemonicParsing="false" onAction="#goBackToMenu" styleClass="btn-danger" text="Regresar" />
      </HBox>
   </children>
</VBox>