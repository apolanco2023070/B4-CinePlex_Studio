<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" styleClass="root" stylesheets="@/org/cineplex/system/resources/styles/cineplex.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="org.cineplex.system.controller.LoginController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label styleClass="title-label" text="CinePlex Studio" />
    <Label styleClass="subtitle-label" text="Iniciar Sesión" />

    <VBox alignment="CENTER" maxWidth="320" spacing="12.0" styleClass="filter-bar">
        <TextField fx:id="usernameField" promptText="Usuario" />
        <PasswordField fx:id="passwordField" promptText="Contraseña" />
        <Label fx:id="lblErrorMessage" styleClass="error-label" wrapText="true" />
        <Button onAction="#handleLogin" prefWidth="300" text="Ingresar al Sistema" />
    </VBox>
</VBox>